# Copy to .env and fill. .env is gitignored — keep it that way.

# * Required to run the Telegram channel.
TELEGRAM_TOKEN=

# * Required to run the WhatsApp channel (python3 -m sathi.main --whatsapp).
# * From Meta Business Suite → your app → WhatsApp → API Setup.
# ! WHATSAPP_TOKEN must be a System User token. The 24-hour test token in the
# ! dashboard expires overnight and takes the bot down with it.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# ! The app secret signs every webhook Meta sends. Without it the endpoint
# ! believes anyone who finds the URL, so the adapter refuses to start.
WHATSAPP_APP_SECRET=
# * Any string you choose. Meta echoes it back once, when you first save the
# * webhook URL in the dashboard.
WHATSAPP_VERIFY_TOKEN=
# * Plain HTTP, bound behind the TLS proxy. Meta requires HTTPS on the outside.
WHATSAPP_PORT=8080
# * Graph API version. Pinned so a Meta release cannot change our payloads
# * overnight, and env-set so a retirement is a restart, not a deploy.
WHATSAPP_API_VERSION=v21.0

# * Optional. Unset is a supported, tested configuration: the bot falls back to
# * numbered buttons and templated Hindi, and every eligibility result is
# * identical. The model's only job is to suggest an occupation for free text,
# * always confirmed by the worker — and no signed scheme asks occupation
# * today, so in normal use it is never called.
LLM_API_KEY=
# * Anthropic Messages API by default. Change only if you know why.
# LLM_BASE_URL=https://api.anthropic.com/v1/messages
# LLM_MODEL=claude-sonnet-5

# ! REQUIRED in production. The reach table stores HMAC(key, channel id), and a
# ! WhatsApp channel id is a phone number: small enough to enumerate. Keep the
# ! key here (0600), never in the database. install-on-vm.sh generates one on a
# ! new host and preserves it on redeploy; migrate an old host with
# !   python3 -m sathi.metrics.events --migrate-reach-key /etc/sathi/sathi.env
REACH_HMAC_KEY=

# * Pack links: the Telegram process serves /p/<token> on PACK_BIND:PACK_PORT.
# * Leave PACK_BASE_URL empty on a laptop — a link to an unreachable host is
# * worse than no link, and the file is still sent.
PACK_BASE_URL=
# PACK_PORT=8081
# PACK_BIND=127.0.0.1
# * Where the expired-link page sends people back to.
BOT_URL=https://t.me/YojanaSathiBot
# * Extra origins allowed to read /stats.json, comma-separated. The landing
# * page's own origins are built in.
# STATS_ORIGIN=

# * The WhatsApp webhook binds loopback; Caddy holds TLS in front of it.
# WHATSAPP_BIND=127.0.0.1

# ! Follow-up opt-ins. Leave unset: the sender that would deliver a follow-up
# ! is not built, and a salted hash cannot address a message.
# FOLLOWUP_SALT=

# * Where data/ lives, if not beside the code. Tests and odd layouts only.
# SATHI_DATA_DIR=

# * Optional voice notes. WhatsApp accepts .ogg (opus), .mp3, .m4a, .aac and
# ! .amr only — the espeak-ng example below writes .wav, which Telegram takes
# ! and WhatsApp silently will not, so voice is skipped there until this
# ! command writes a supported format.
# *   TTS_CMD='espeak-ng -v hi -w {out} {text}'
TTS_CMD=

# * Where the event log lives. On a deployed container this MUST point at a
# ! persistent volume — an ephemeral disk means every impact number is lost on
# ! the next restart.
DB_PATH=./sathi.db
