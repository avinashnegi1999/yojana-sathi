# =====================================================================
# Scheme Sathi — public web screening service
# =====================================================================
# ! Caddy owns public TLS. This service stays on loopback, so an AWS security
# group can never accidentally expose the plain HTTP port.

[Unit]
Description=Scheme Sathi — public web screening service
Documentation=https://github.com/avinashnegi1999/yojana-sathi
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=sathi
Group=sathi
WorkingDirectory=/opt/sathi
EnvironmentFile=/etc/sathi/sathi.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m sathi.local_web --port 8765 --db /var/lib/sathi/sathi.db --secure-cookie
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sathi-web
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sathi
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
